# ============================================================
#  CineP2P 8.0 - stream bruto + audio decodificado no navegador
#  TMDB_API_KEY obrigatoria. https://www.themoviedb.org/settings/api
# ============================================================
TMDB_API_KEY=SUA_CHAVE_AQUI
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR

# Servidor
PORT=3000
HOST=0.0.0.0

# Filtros
FILTRO_ESTRITO=1
FILTRO_INSTALADOR=1

# Scrapers (vazio = todos)
SCRAPER_TIMEOUT=9
SCRAPERS_ENABLED=

# Player - modo BRUTO: nenhum ffmpeg, CPU zero, inicio instantaneo
TRANSCODE=nunca
METADATA_TIMEOUT=60
BUFFER_TIMEOUT=150
MAX_CONNS=300
MAX_JOBS=3
IDLE_TIMEOUT=900000
MIN_BUFFER_PERCENT=1
MIN_BUFFER_MB=2

# uTP: 0 = somente TCP
ENABLE_UTP=0

# Legendas
MAX_SUBS=8

# Limpeza de disco: session = apaga ao fechar | keep = mantem cache
CACHE_MODE=session
TORRENT_CACHE_DIR=cache