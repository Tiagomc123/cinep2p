# ============================================================
#  CineP2P 3.0
#  Cole sua chave do TMDb em TMDB_API_KEY e reinicie o servidor.
#  https://www.themoviedb.org/settings/api
# ============================================================
TMDB_API_KEY=SUA_CHAVE_AQUI
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR

# Servidor (HOST 0.0.0.0 permite acessar pelo celular na mesma rede)
PORT=3000
HOST=0.0.0.0

# Scrapers
SCRAPER_TIMEOUT=9
SCRAPERS_ENABLED=

# P2P
METADATA_TIMEOUT=40
MAX_CONNS=200
MAX_JOBS=3
IDLE_TIMEOUT=720000
MIN_BUFFER_PERCENT=4
MIN_BUFFER_MB=12

# Limpeza de disco: session = apaga tudo ao fechar o player | keep = mantem cache
CACHE_MODE=session
TORRENT_CACHE_DIR=cache